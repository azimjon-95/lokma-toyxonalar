# Server manzili. Bo'sh qoldirilsa ilova ichki demo ma'lumotlar (mock) bilan ishlaydi.
# Masalan: https://api.lokma.uz
EXPO_PUBLIC_API_URL=

# Android uchun Google Maps kaliti (Google Cloud Console -> Maps SDK for Android)
GOOGLE_MAPS_ANDROID_KEY=

# ── Xarita (web / Telegram Mini App) ──
# Yandex Maps JS API v3 kaliti. Kalitda "Ограничение по HTTP Referer" to'ldirilgan bo'lishi SHART.
# Bo'sh bo'lsa yoki Yandex ishlamasa — avtomatik OpenStreetMap (Leaflet).
EXPO_PUBLIC_YANDEX_MAPS_KEY=
# Ixtiyoriy: qidiruv/geokoder va marshrut kalitlari (Yandex `setApikeys` orqali ulanadi)
EXPO_PUBLIC_YANDEX_GEOCODER_KEY=
EXPO_PUBLIC_YANDEX_ROUTING_KEY=
# auto | yandex | maplibre | osm
EXPO_PUBLIC_MAP_PROVIDER=auto
# MapLibre uslubi (kalitsiz OpenFreeMap): liberty | bright | positron
# EXPO_PUBLIC_MAPLIBRE_STYLE=https://tiles.openfreemap.org/styles/liberty
# Sinov: xaritada qaysi provayder ishlayotganini va zaxiraga o'tish sababini ko'rsatadi
EXPO_PUBLIC_MAP_DIAG=0
# Yandex tili: ru_RU | en_US | tr_TR | uk_UA ... (o'zbekcha yo'q)
EXPO_PUBLIC_YANDEX_LANG=ru_RU
# Leaflet (oxirgi zaxira) plitkalari — ixtiyoriy; standart OSM
# EXPO_PUBLIC_MAP_TILES_URL=
# EXPO_PUBLIC_MAP_ATTRIBUTION=
