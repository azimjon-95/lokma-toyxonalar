# ── Yandex Maps (TEST kalitlar) ──
# Bular brauzer kodiga kiradigan OCHIQ kalitlar (EXPO_PUBLIC_*): ularni "Ограничение по HTTP Referer" himoya qiladi,
# shuning uchun kabinetda ruxsat etilgan domenlar (wedding.lokma.uz, *.lokma.uz, lokma.uz, *.vercel.app) yozilgan bo'lishi SHART.
# Vercel Environment Variables'dagi qiymatlar bu fayldan USTUN turadi (Expo mavjud env'ni bosib o'tmaydi) —
# keyinchalik kalitni Vercel'ga ko'chirib, shu qatorlarni o'chirib tashlash mumkin.
EXPO_PUBLIC_YANDEX_MAPS_KEY=a8d5d769-b6be-4f5a-8fdb-5ea3eb5109ac
EXPO_PUBLIC_YANDEX_GEOCODER_KEY=a8d5d769-b6be-4f5a-8fdb-5ea3eb5109ac
EXPO_PUBLIC_YANDEX_ROUTING_KEY=301d9766-ae15-4e2c-ae6f-e3e102a28ced
# maplibre — Yandex'ga urinmasdan to'g'ridan-to'g'ri MapLibre/OpenFreeMap (kalitsiz). Yandex'ni yoqish: kabinetda domenni
# Referer ro'yxatiga qo'shing, so'ng auto qiling.
EXPO_PUBLIC_MAP_PROVIDER=maplibre
